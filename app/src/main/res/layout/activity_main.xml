<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05060A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:layout_marginTop="36dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_round" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="BeatWall"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <!-- Auto-hides once granted -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#11131C"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Media Session Access"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnNotifAccess"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Auto-hides once granted -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            app:cardBackgroundColor="#11131C"
            app:cardCornerRadius="18dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Unrestricted Battery"
                    android:textColor="#F8FAFC"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/btnBattery"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Allow" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Minimalist Current Vibe Card (shown when permissions are ready) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#11131C"
            app:cardCornerRadius="20dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="16dp">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgCurrentCover"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:scaleType="centerCrop"
                    android:src="@mipmap/ic_launcher_round"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtActiveDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● Connected"
                        android:textColor="#34D399"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/txtCurrentTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Ready"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCurrentArtist"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Play Spotify, YT Music, or NotebookLM"
                        android:textColor="#94A3B8"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Location & Live Sky Astronomy Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSkyLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="22dp"
            app:cardBackgroundColor="#11131C"
            app:cardCornerRadius="20dp"
            app:strokeColor="#1E293B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/txtLocationCity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Rourkela, Odisha"
                            android:textColor="#F8FAFC"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtSkyMetrics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Sunrise 6:06 AM • Sunset 5:09 PM"
                            android:textColor="#94A3B8"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnDetectCity"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detect" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/edtCityInput"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:background="#0B0D14"
                        android:hint="City or PIN (e.g. Puri, 769002)"
                        android:imeOptions="actionDone"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:singleLine="true"
                        android:textColor="#F8FAFC"
                        android:textColorHint="#64748B"
                        android:textSize="13sp" />

                    <Button
                        android:id="@+id/btnSetCity"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Set" />
                </LinearLayout>

                <!-- 24-Hour Time-Travel Sky Preview Slider -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <SeekBar
                        android:id="@+id/seekTimeTravel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="1439"
                        android:progress="720" />

                    <Button
                        android:id="@+id/btnPrevLive"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="Live"
                        android:textSize="11sp" />
                </LinearLayout>

                <!-- 20-World Firewatch Quick Preview Selector -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnWorldToday"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:text="Today"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldForest"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Firewatch"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldDunes"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Dunes"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldSnow"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Snowy Lake"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldMesa"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Savanna"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldOcean"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Ocean"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldWoodland"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Woodland"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldReeds"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Reeds"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldCove"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Cove"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldTorii"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Torii Lake"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldLighthouse"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Lighthouse"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldFjord"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Aurora Fjord"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldStag"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Valley Stag"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldCappadocia"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Cappadocia"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldOdisha"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Odisha Ghat"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldHimalaya"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Himalaya"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldViaduct"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Viaduct"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldWindmill"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Windmill"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldBamboo"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Bamboo"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldVolcano"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Volcano"
                            android:textSize="11sp" />

                        <Button
                            android:id="@+id/btnWorldHighland"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="34dp"
                            android:layout_marginStart="6dp"
                            android:text="Highland"
                            android:textSize="11sp" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/btnSetWallpaper"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:backgroundTint="#38BDF8"
            android:text="Set Live Wallpaper"
            android:textColor="#04060A"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
